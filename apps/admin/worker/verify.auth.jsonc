// Local instrumentation only. Never deploy either configuration.
{
  "name": "atelier-auth-verification",
  "main": "verify-auth.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH",
        "class_name": "OwnerAuth",
      },
    ],
  },
  "migrations": [
    {
      "tag": "verification-v1",
      "new_sqlite_classes": ["OwnerAuth"],
    },
  ],
}
