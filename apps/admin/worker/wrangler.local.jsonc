{
  "name": "atelier-admin-local-proof",
  "main": "index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "AUTH", "class_name": "OwnerAuth" }],
  },
  "migrations": [{ "tag": "local-v1", "new_sqlite_classes": ["OwnerAuth"] }],
  "vars": {
    "LOCAL_COMPAT_PROOF": "1",
    "SANITY_PROJECT_ID": "fixture01",
    "SANITY_DATASET": "production",
    "SANITY_API_VERSION": "2025-02-19",
    "ADMIN_ORIGIN": "http://127.0.0.1:3002",
  },
}
